# Public PostHog project key (leave blank to disable analytics locally)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Web3Forms access key for the contact form.
# Get one free at https://web3forms.com by entering the inbox that should
# receive enquiries. This key is public by design: it only allows sending
# to that verified inbox, so it is safe in the browser bundle.
VITE_WEB3FORMS_KEY=
